# Copiar este archivo como .env y completar con los valores reales.
# NUNCA subir el archivo .env (con credenciales reales) al repositorio.

# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/sicen?retryWrites=true&w=majority

# Puerto del servidor Express
PORT=4000

# Secreto para firmar los tokens JWT
JWT_SECRET=cambiar_este_valor_por_un_secreto_seguro

# Tiempo de expiración del token (ej. 1h, 8h, 7d)
JWT_EXPIRES_IN=8h
